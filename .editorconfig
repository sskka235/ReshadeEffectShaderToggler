# EditorConfig — https://editorconfig.org
# Aligned with src/.clang-format (Mozilla-based, 4-space indent, column 160).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 160

# C/C++ sources and headers
[*.{c,cpp,h,hpp,hlsl}]
indent_style = space
indent_size = 4

# Build / project files use tabs by convention
[*.{vcxproj,vcxproj.filters,sln}]
indent_style = tab

[.gitmodules]
indent_style = tab

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
